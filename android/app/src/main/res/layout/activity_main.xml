<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#10131B"><LinearLayout android:padding="24dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="FAMILY GUARDIAN  PRO" android:textColor="#FFC857" android:textStyle="bold" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Your family,\nwithin reach." android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Not paired · Location sharing is off" android:textColor="#AEB8CA" android:background="#1B2230" android:padding="18dp" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/server" android:hint="Server URL (https://your-domain)" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#AEB8CA" android:inputType="textUri" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/paircode" android:hint="Pairing code or scan QR" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#AEB8CA" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/scan" android:text="Scan pairing QR" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/pair" android:text="Pair this device" android:backgroundTint="#FFC857" android:textColor="#10131B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/device" android:text="Device: not paired" android:textColor="#AEB8CA" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/start" android:text="Start location sharing" android:backgroundTint="#FFC857" android:textColor="#10131B" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="Stop location sharing" android:backgroundTint="#303849" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/battery" android:text="Battery: —" android:textColor="#AEB8CA" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Sharing is visible in your notification tray. You can stop it here at any time." android:textColor="#AEB8CA" android:textSize="13sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
